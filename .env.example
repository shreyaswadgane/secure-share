# ==========================================
# Secure Share - Example Environment Setup
# Copy this file to .env and configure your secrets
# ==========================================

# Secret key for Flask session signing
SECRET_KEY=your-flask-secret-key-here

# Fernet 32-byte base64 Master Key for Envelope Encryption
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=your-32-byte-base64-fernet-key-here

# Database URI (SQLite default; can be changed to MySQL / PostgreSQL)
# Example SQLite: sqlite:///secureshare.db
# Example MySQL: mysql+pymysql://username:password@localhost:3306/secureshare
DATABASE_URL=sqlite:///secureshare.db

# Server settings
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
